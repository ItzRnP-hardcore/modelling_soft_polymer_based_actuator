NLGEOM,ON              ! Large-deflection follower pressure & finite strain
AUTOTS,ON
NSUBST,22,110,22
OUTRES,ALL,ALL

! Apply follower pressure P = 110.000 kPa (0.110000 MPa) on cavity faces (face 1 of SURF154)
ESEL,S,TYPE,,2
SFE,ALL,1,PRES,,0.110000
ALLSEL,ALL
SOLVE
FINISH

! --- 9. Post-processing: export P, tip deflection delta, tip angle theta ---
/POST26
NSOL,2,2187,U,X,UX_TOP
NSOL,3,2187,U,Y,UY_TOP
NSOL,4,2041,U,X,UX_BOT
NSOL,5,2041,U,Y,UY_BOT
*CFOPEN,ansys_sleeve_summary,csv
*VWRITE,'P_kPa,x_tip_mm,delta_mm,theta_deg'
(A)
*GET,NSETS,ACTIVE,0,SET,NSET
/POST1
*DO,ISET,1,NSETS
  SET,1,ISET
  *GET,TFAC,ACTIVE,0,SET,TIME
  P_KPA = TFAC * 110.000000
  X_TOP = NX(2187) + UX(2187)
  Y_TOP = NY(2187) + UY(2187)
  X_BOT = NX(2041) + UX(2041)
  Y_BOT = NY(2041) + UY(2041)
  X_TIP = 0.5 * (X_TOP + X_BOT)
  DELTA = -0.5 * (Y_TOP + Y_BOT)
  THETA_DEG = ATAN2(X_TOP - X_BOT, Y_TOP - Y_BOT) * 180.0 / 3.141592653589793
  *VWRITE,P_KPA,X_TIP,DELTA,THETA_DEG
  (F10.4,',',F12.5,',',F12.5,',',F12.5)
*ENDDO
*CFCLOSE
FINISH